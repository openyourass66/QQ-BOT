{
  "name": "qq-bot-bridge",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/run.mjs setup",
    "desktop:build": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build.ps1",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/start.ps1",
    "build": "node scripts/build.mjs",
    "start": "node scripts/run.mjs bridge",
    "mcp": "node scripts/run.mjs mcp",
    "mock": "node scripts/dev/mock-onebot.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=2 tests/*.test.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "benchmark:store": "npm run build && node --expose-gc scripts/benchmark-store.mjs",
    "napcat": "node scripts/run.mjs napcat",
    "components": "node scripts/components.mjs",
    "package:dir": "npm run desktop:build && node scripts/package.mjs",
    "server": "node scripts/server.mjs start",
    "server:init": "node scripts/server.mjs init",
    "server:reset-auth": "node scripts/server.mjs reset-auth",
    "web:build": "vite build --config web/vite.config.mjs",
    "test:web-ui": "npm run web:build && node tests/web-smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "fastify": "5.12.7",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.18.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
