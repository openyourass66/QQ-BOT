<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ BOT · 桌面控制台" Width="1100" Height="780" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8" Foreground="#202832"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="MutedBrush" Color="#626D7C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE1E7"/>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CBD2DA"/><Setter Property="Foreground" Value="#263241"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#23744E"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#235F44"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#235F44"/></Style>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#ABB5C1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#B7D9C5"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#23744E"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers></Style>
    <Style TargetType="CheckBox"><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="5,0"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2B3B34"/><Setter Property="Foreground" Value="#D2F2C2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#BCE59F"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#151D24"><DockPanel Margin="18,30,18,20">
      <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30"><TextBlock Text="Q ·  QQ BOT" FontSize="23" FontWeight="Bold" Foreground="#C5EBAA"/><TextBlock Text="本地桌面控制台" Foreground="#A5B1BE" FontSize="12" Margin="0,8,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,0"><TextBlock Text="WINDOWS NATIVE" Foreground="#C5EBAA" FontSize="10"/><TextBlock Text="原生窗口 · 本地运行" Foreground="#A5B1BE" FontSize="11" Margin="0,8,0,0"/></StackPanel>
      <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="#B5C0CD" SelectedIndex="0" AutomationProperties.Name="功能导航">
        <ListBoxItem Content="运行概览"/><ListBoxItem Content="机器人配置"/><ListBoxItem Content="角色与人设"/><ListBoxItem Content="会话管理"/><ListBoxItem Content="运行日志"/>
      </ListBox>
    </DockPanel></Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,0"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="ConnectionLabel" Text="正在启动本地控制服务…" Foreground="{StaticResource MutedBrush}" FontSize="12" DockPanel.Dock="Right"/><TextBlock Text="工作空间  /  机器人管理" FontSize="12"/></DockPanel></Border>
      <Grid Grid.Row="1" Margin="30,26,30,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24"><TextBlock x:Name="PageTitle" Text="运行概览" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="掌握连接状态，让每一次对话稳定发生。" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel>
        <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel>
          <Border Style="{StaticResource Card}" Background="#EDF4EE" BorderBrush="#D2DFD2"><StackPanel>
            <TextBlock Text="ROBOT STATUS" FontSize="10" Foreground="#536957"/>
            <DockPanel Margin="0,12,0,8"><Border DockPanel.Dock="Right" Background="#DDE8DE" Padding="12,4" CornerRadius="5"><TextBlock x:Name="PhaseLabel" Text="已停止" Foreground="#345B40" FontSize="12"/></Border><TextBlock x:Name="BotName" Text="QQ 机器人" FontSize="24" FontWeight="SemiBold"/></DockPanel>
            <TextBlock x:Name="RuntimeDetail" Text="控制台保持在线，随时可以启动机器人。" Style="{StaticResource Hint}" Margin="0,0,0,22"/>
            <StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="启动机器人" Style="{StaticResource PrimaryButton}" IsEnabled="False"/><Button x:Name="StopButton" Content="停止" Foreground="#A73232" IsEnabled="False"/><Button x:Name="RestartButton" Content="重新启动" IsEnabled="False"/></StackPanel>
          </StackPanel></Border>
          <UniformGrid Columns="4" Margin="0,0,-12,0">
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,18"><StackPanel><TextBlock Text="接收消息" Style="{StaticResource Hint}"/><TextBlock x:Name="MessagesIn" Text="—" FontSize="28" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,18"><StackPanel><TextBlock Text="发送消息" Style="{StaticResource Hint}"/><TextBlock x:Name="MessagesOut" Text="—" FontSize="28" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,18"><StackPanel><TextBlock Text="活跃会话" Style="{StaticResource Hint}"/><TextBlock x:Name="SessionCount" Text="—" FontSize="28" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,18"><StackPanel><TextBlock Text="待处理消息" Style="{StaticResource Hint}"/><TextBlock x:Name="PendingCount" Text="—" FontSize="28" Margin="0,7,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="连接检查" Style="{StaticResource Heading}"/><TextBlock x:Name="Connections" Text="OneBot  未连接     ·     DSH / ACP  未连接     ·     QQ  离线" TextWrapping="Wrap"/><TextBlock x:Name="AccountInfo" Text="等待获取 QQ 登录信息" Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="发送测试消息" Style="{StaticResource Heading}"/><Label Target="{Binding ElementName=TestMessage}" Content="向管理员 QQ 发送私聊消息" Foreground="{StaticResource MutedBrush}" FontSize="12"/><DockPanel><Button x:Name="TestButton" DockPanel.Dock="Right" Content="发送测试" Margin="12,0,0,0"/><TextBox x:Name="TestMessage" Text="你好，机器人已准备就绪。" MaxLength="2000"/></DockPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="EnvButton" Content="连接配置 (.env)"/><Button x:Name="SaveSettingsButton" Content="保存配置" Style="{StaticResource PrimaryButton}" IsEnabled="False"/></StackPanel><TextBlock Text="保存后自动热更新" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel x:Name="SettingsFields"/></ScrollViewer></Grid>
        <Grid x:Name="PersonaPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="定义机器人的身份、语气与规则。保存后可重置相关会话，让新设定进入新的上下文。" Style="{StaticResource Hint}" Margin="0,0,0,16"/><TextBox x:Name="PersonaText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Top" AutomationProperties.Name="角色设定与工作区说明"/><Button x:Name="SavePersonaButton" Grid.Row="2" Content="保存人设" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="False"/></Grid>
        <Grid x:Name="SessionsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button x:Name="RefreshSessionsButton" Content="刷新会话" DockPanel.Dock="Right"/><TextBlock Text="重置后，下次消息会创建新的上下文。" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SessionList"/></ScrollViewer></Grid>
        <Grid x:Name="LogsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button x:Name="PauseLogsButton" Content="暂停刷新" DockPanel.Dock="Right"/><TextBox x:Name="LogSearch" AutomationProperties.Name="筛选日志关键词" ToolTip="筛选日志关键词" MinWidth="180"/><TextBlock Text="关键词" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource MutedBrush}"/></DockPanel><TextBox x:Name="LogText" Grid.Row="1" Background="#151D24" Foreground="#D2DFEA" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.Name="运行日志"/></Grid>
      </Grid>
      <Border Grid.Row="2" Background="#E9EDF1" Padding="30,0"><TextBlock x:Name="Feedback" Text="本地桌面模式 · 未启动机器人" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></Border>
    </Grid>
  </Grid>
</Window>
