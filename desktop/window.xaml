<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="小鲸工作台" Width="1280" Height="860" MinWidth="1000" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#F5F7FB" Foreground="#25324B" FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>

 <Border Background="#F5F7FB" BorderBrush="#DAE2F0" BorderThickness="1" CornerRadius="10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.ColumnSpan="2" Background="#FCFDFF" BorderBrush="#E8EDF5" BorderThickness="0,0,0,1">
    <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="Minimize" Style="{StaticResource Caption}" ToolTip="最小化" AutomationProperties.Name="最小化"><Grid Width="12" Height="12"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M1,6.5 H11"/></Grid></Button>
     <Button x:Name="Maximize" Style="{StaticResource Caption}" ToolTip="最大化" AutomationProperties.Name="最大化或还原"><Grid Width="12" Height="12"><Path x:Name="MaximizeGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M1.5,1.5 H10.5 V10.5 H1.5 Z"/></Grid></Button>
     <Button x:Name="CloseWindow" Style="{StaticResource CaptionClose}" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口"><Grid Width="12" Height="12"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M1.5,1.5 L10.5,10.5 M1.5,10.5 L10.5,1.5"/></Grid></Button>
    </StackPanel><TextBlock Text="小鲸工作台" Foreground="#7A879D" FontSize="11" Margin="19,0,0,0" VerticalAlignment="Center"/></DockPanel>
   </Border>
   <Border Grid.Row="1" Background="White" BorderBrush="#E8EDF5" BorderThickness="0,0,1,0">
    <Grid Margin="20,28,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><DockPanel><Image x:Name="BrandIcon" Width="36" Height="36" DockPanel.Dock="Left" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="小鲸" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="WHALE DESK" Foreground="#8491A7" FontSize="9" Margin="0,2,0,0"/></StackPanel></DockPanel><TextBlock Text="工作空间" FontSize="10" Foreground="#98A3B6" Margin="12,35,0,0"/></StackPanel>
     <TextBlock Grid.Row="2" Text="QQ BOT  /  轻量桌面端" Foreground="#96A2B6" FontSize="10" Margin="12,0,0,0"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Grid.Column="1" Margin="28,24,28,0" VerticalAlignment="Top">
    <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="Uptime" Text="尚未启动" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/><Border x:Name="ConnectionPill" Background="#EDF1F7" CornerRadius="13" Padding="11,6"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Fill="#98A5BC" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionBadge" Text="未启动" Foreground="#66748C" FontSize="11"/></StackPanel></Border></StackPanel>
     <StackPanel><TextBlock x:Name="PageTitle" Text="工作总览" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="连接、消息与运行状态，一目了然。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    </DockPanel>
   </Grid>
   <TabControl x:Name="Tabs" Grid.Row="1" Grid.ColumnSpan="2" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel IsItemsHost="True" VerticalAlignment="Top" Margin="12,126,12,0"/>
     <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" TextElement.Foreground="#25324B" Margin="28,104,28,42"/>
    </Grid></ControlTemplate></TabControl.Template>
    <TabItem Tag="Overview" Header="工作总览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border x:Name="SetupPrompt" Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,14" Visibility="Collapsed"><DockPanel><Button x:Name="StartSetup" DockPanel.Dock="Right" Content="快速配置 →" Style="{StaticResource Primary}" Margin="16,0,0,0"/><StackPanel><TextBlock Text="第一次使用？从这里开始" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="检测环境、选择模型、连接 QQ，四步完成基础设置。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
     <Border CornerRadius="18" Padding="24,22" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#E9EFFF"/><GradientStop Color="#F0F5FF" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
       <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#DDE6FF" CornerRadius="5" Padding="7,3"><TextBlock Text="HELLO, WHALE" FontSize="9" Foreground="#536FC0" FontWeight="SemiBold"/></Border><TextBlock Text="今天也请多多关照" Foreground="#7384A9" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel>
        <TextBlock x:Name="State" Text="小鲸准备好了，随时出发" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,7" TextWrapping="Wrap"/>
        <TextBlock x:Name="Stats" Text="启动机器人，开始今天的陪伴。" Foreground="#60759F" FontSize="12" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,18,0,0"><Button x:Name="Start" Style="{StaticResource Primary}" Content="启动机器人" MinWidth="122" Margin="0,0,10,0"/><Button x:Name="RestartBot" Content="重新启动" Margin="0,0,10,0" ToolTip="使用已保存的配置重新启动机器人和受管 QQ 进程"/><Button x:Name="Stop" Content="停止运行" Background="#F8FAFF"/></WrapPanel>
       </StackPanel>
       <Image x:Name="HeroIcon" Grid.Column="1" Width="216" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Border Style="{StaticResource Surface}" Margin="0,0,0,18" Padding="8,19"><UniformGrid Columns="4">
      <StackPanel Margin="18,0"><TextBlock Text="收到消息" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MessagesIn" Text="0" FontSize="26" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="本次运行" FontSize="10" Foreground="#94A0B4"/></StackPanel>
      <StackPanel Margin="18,0"><TextBlock Text="已发送回复" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MessagesOut" Text="0" FontSize="26" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="成功送达 QQ" FontSize="10" Foreground="#94A0B4"/></StackPanel>
      <StackPanel Margin="18,0"><TextBlock Text="活跃会话" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Sessions" Text="0" FontSize="26" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="按需恢复上下文" FontSize="10" Foreground="#94A0B4"/></StackPanel>
      <StackPanel Margin="18,0"><TextBlock Text="待处理消息" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Pending" Text="0" FontSize="26" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock x:Name="QueueState" Text="队列空闲" FontSize="10" Foreground="#94A0B4"/></StackPanel>
     </UniformGrid></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Surface}" Margin="0,0,16,0"><StackPanel>
       <DockPanel Margin="0,0,0,18"><TextBlock Text="服务连接" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="QQ → 模型" Foreground="#94A0B4" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
       <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#ECF6F2" CornerRadius="10" Width="31" Height="31" VerticalAlignment="Top"><Path Stroke="#53A38A" StrokeThickness="1.5" Data="M2,2 H14 V11 H9 L5,15 V11 H2 Z" Stretch="Uniform" Margin="8"/></Border><StackPanel Grid.Column="1"><TextBlock Text="QQ · NapCat" FontWeight="Medium"/><TextBlock x:Name="NapcatState" Text="等待启动" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="QqState" Grid.Column="2" Text="未连接" Foreground="#7F8BA2" FontSize="11" VerticalAlignment="Center"/></Grid>
       <Border Background="#EEF1F7" Height="1" Margin="0,0,0,17"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#EDF0FF" CornerRadius="10" Width="31" Height="31" VerticalAlignment="Top"><Path Stroke="#647DEA" StrokeThickness="1.5" Data="M7,1 L8,5 L12,6 L8,7 L7,11 L6,7 L2,6 L6,5 Z" Stretch="Uniform" Margin="8"/></Border><StackPanel Grid.Column="1"><TextBlock Text="DeepSeek · DSH" FontWeight="Medium"/><TextBlock x:Name="ModelState" Text="等待连接" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button x:Name="Restart" Grid.Column="2" Content="重连" Style="{StaticResource Quiet}" ToolTip="重新连接模型，保留 QQ 登录"/></Grid>
       <Border Background="#F7F9FD" CornerRadius="9" Padding="11" Margin="0,18,0,0"><TextBlock Text="模型重连会保留 QQ 登录状态" Foreground="#71809A" FontSize="10" TextWrapping="Wrap"/></Border>
      </StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Surface}"><StackPanel><DockPanel Margin="0,0,0,18"><TextBlock Text="环境检查" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="启动诊断" Foreground="#94A0B4" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><TextBlock Text="运行依赖、连接配置与文件权限" Foreground="#71809A" FontSize="11" Margin="0,0,0,12"/><TextBlock x:Name="HealthSummary" Text="检查环境，确认小鲸已经准备好。" Foreground="#526787" TextWrapping="Wrap" FontSize="12"/><Button x:Name="Diagnose" Content="查看启动诊断 →" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="-10,16,0,0"/></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Tag="Activity" Header="QQ 活动"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,15">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="SocialSection" DisplayMemberPath="Name" SelectedValuePath="Key" AutomationProperties.Name="活动类型">
        <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="11,12,11,5"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
       </ComboBox>
       <TextBox x:Name="SocialSearch" Grid.Column="1" Tag="搜索名字、会话或内容…" Margin="12,0" AutomationProperties.Name="搜索活动"/>
       <Button x:Name="SocialRefresh" Grid.Column="2" Content="刷新列表"/>
       <Button x:Name="SocialContacts" Grid.Column="3" Content="同步联系人" Style="{StaticResource Primary}" Margin="9,0,0,0"/>
      </Grid>
     </Border>
     <DockPanel Grid.Row="1" Margin="2,0,2,13"><TextBlock x:Name="SocialCount" Text="记录与联系人" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="SocialNote" Text="查询后查看记录与执行结果" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300" MinWidth="265"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10">
       <Grid><ListView x:Name="SocialList" AutomationProperties.Name="QQ 活动记录" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.ItemTemplate><DataTemplate><Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="32" Height="32" Background="{Binding AvatarFill}" CornerRadius="10" VerticalAlignment="Top" HorizontalAlignment="Left"><TextBlock Text="{Binding Avatar}" Foreground="{Binding AvatarInk}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SummaryDisplay}" Foreground="#66748C" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryDisplay}"/></StackPanel>
         <StackPanel Grid.Column="2" HorizontalAlignment="Right"><Border Background="{Binding StatusFill}" CornerRadius="5" Padding="7,3" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusInk}" FontSize="10"/></Border><TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="#66748C" Margin="0,7,0,0" HorizontalAlignment="Right"/></StackPanel>
        </Grid></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <StackPanel x:Name="SocialEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20">
        <Border Width="54" Height="54" CornerRadius="17" Background="#F0F3FC" HorizontalAlignment="Center" Margin="0,0,0,15"><Path Data="M2,2 H22 V18 H14 L8,23 V18 H2 Z M7,8 H17 M7,12 H14" Stroke="#879BC7" StrokeThickness="1.5" Stretch="Uniform" Margin="15"/></Border>
        <TextBlock x:Name="SocialEmptyTitle" Text="从这里查看小鲸的活动" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="SocialEmptyHint" Text="刷新记录，或同步 QQ 联系人。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,9,0,0"/>
       </StackPanel></Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="调整记录和详情宽度"/>
      <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="记录详情" Foreground="#66748C" FontSize="10" Margin="0,0,0,13"/><TextBlock x:Name="SocialDetailTitle" Text="尚未选择记录" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock x:Name="SocialDetailMeta" Text="选择左侧一条记录查看详情。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
         <Border x:Name="SocialDetailBadge" Background="#F1F4FA" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="SocialState" Text="" FontSize="10"/></Border>
         <Border Background="{StaticResource Line}" Height="1" Margin="0,18,0,14"/>
        </StackPanel>
        <Grid Grid.Row="1"><TextBox x:Name="SocialDetail" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="活动详情或兴趣主题"/>
         <TextBlock x:Name="SocialDetailEmpty" Text="联系人、聊天和执行结果，
都可以在这里展开查看。" Foreground="#66748C" FontSize="11" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel x:Name="SocialActionPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,0">
         <Button x:Name="SocialProfile" Content="会话人设与参与" Style="{StaticResource Primary}" HorizontalContentAlignment="Center" Margin="0,0,0,8"/>
         <Button x:Name="SocialSave" Content="保存兴趣主题" Style="{StaticResource Primary}" Margin="0,0,0,8"/>
         <Button x:Name="SocialUnblock" Content="解除屏蔽" Style="{StaticResource Quiet}" Padding="9,7" HorizontalAlignment="Left"/>
         <Border x:Name="SocialDangerActions" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0"><WrapPanel><Button x:Name="SocialReset" Content="重置会话" Style="{StaticResource Quiet}" Padding="9,7"/><Button x:Name="SocialBlock" Content="屏蔽对象" Style="{StaticResource Quiet}" Foreground="{StaticResource Danger}" Padding="9,7"/><Button x:Name="SocialDelete" Content="删除记录" Style="{StaticResource Quiet}" Foreground="{StaticResource Danger}" Padding="9,7"/></WrapPanel></Border>
        </StackPanel>
       </Grid>
      </Border>
     </Grid>
    </Grid></TabItem>
    <TabItem Margin="0,14,0,6" Tag="Knowledge" Header="人设与记忆"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6" Margin="0,0,0,16"><ListBox x:Name="KnowledgeNav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsNavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="人设与记忆分类"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></Border>
     <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="KnowledgeSearch" Tag="搜索名称或内容" AutomationProperties.Name="搜索人设或记忆" Margin="0,0,10,0"/>
      <Button x:Name="KnowledgeRefresh" Grid.Column="1" Content="刷新列表" Margin="0,0,8,0"/>
      <Button x:Name="KnowledgeNew" Grid.Column="2" Content="新建人设" Style="{StaticResource Primary}"/>
      <Button x:Name="Memory" Grid.Column="3" Content="打开目录" Visibility="Collapsed" Margin="8,0,0,0"/>
     </Grid>
     <DockPanel Grid.Row="2" Margin="2,0,2,12"><TextBlock x:Name="KnowledgeCount" Text="人设库" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="KnowledgeStatus" Text="保存多套人设，在会话设置中自由选择。" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*" MinWidth="360"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8"><Grid>
       <ListView x:Name="KnowledgeList" AutomationProperties.Name="人设与记忆列表"><ListView.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
       </StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
       <TextBlock x:Name="KnowledgeEmpty" Text="暂无记录" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15" IsHitTestVisible="False" Visibility="Collapsed"/>
      </Grid></Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="调整人设列表和编辑区宽度"/>
      <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="KnowledgeDetailTitle" Text="当前全局人设" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PersonaHint" Text="全局人设用于未指定专属人设的会话。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="17" Margin="0,7,0,12"/></StackPanel>
       <StackPanel x:Name="KnowledgeNamePanel" Grid.Row="1" Margin="0,0,0,12"><TextBlock x:Name="KnowledgeNameLabel" Text="名称" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="KnowledgeName" Tag="为这套人设起一个名字" AutomationProperties.Name="人设名称或记忆文件名"/></StackPanel>
       <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="KnowledgeContentLabel" Text="人设内容" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="Persona" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="12" VerticalScrollBarVisibility="Auto" Padding="12" AutomationProperties.Name="人设或记忆内容"/></Grid>
       <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="KnowledgeError" Foreground="{StaticResource Danger}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
        <DockPanel LastChildFill="True"><WrapPanel DockPanel.Dock="Right"><Button x:Name="DiscardKnowledge" Content="放弃编辑" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="SavePersona" Content="保存全局人设" Style="{StaticResource Primary}"/></WrapPanel><TextBlock x:Name="KnowledgeWordCount" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
        <Border x:Name="KnowledgeSecondaryBar" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0"><DockPanel LastChildFill="True">
         <Border x:Name="KnowledgeDeleteArea" DockPanel.Dock="Right" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0,0,0" Margin="8,0,0,0"><Button x:Name="DeleteKnowledge" Content="删除" Style="{StaticResource Quiet}" Foreground="{StaticResource Danger}" Padding="8,7" Visibility="Collapsed"/></Border>
         <WrapPanel><Button x:Name="ApplyPersona" Content="设为全局人设" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed"/><Button x:Name="CopyPersona" Content="另存为人设" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed"/><Button x:Name="KnowledgeSources" Content="来源与版本" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed"/><Button x:Name="LockMemory" Content="锁定记忆" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed"/><Button x:Name="RestoreMemory" Content="恢复上一版" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed"/><Button x:Name="ActivateLexicon" Content="确认并使用" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed"/><Button x:Name="DisableLexicon" Content="停用词条" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed"/><Button x:Name="ReviewMemory" Content="整理此会话" Style="{StaticResource Quiet}" Padding="8,7" Visibility="Collapsed"/></WrapPanel>
        </DockPanel></Border>
       </StackPanel>
      </Grid></Border>
     </Grid>
    </Grid></TabItem>
    <TabItem Tag="Settings" Header="机器人设置"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,18">
      <TextBox x:Name="SettingsSearch" Tag="搜索设置、功能或关键词" Width="230" DockPanel.Dock="Right" AutomationProperties.Name="搜索机器人设置"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="让小鲸按你的方式工作" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="SettingsCount" Text="设置按主题整理，修改后统一保存。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
     </DockPanel>
     <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6" Margin="0,0,0,18">
      <ListBox x:Name="SettingsNav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsNavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="设置分类">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="11"/><TextBlock Text="{Binding Count}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Border>
      <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
       <StackPanel><TextBlock x:Name="SettingsTitle" Text="对话与参与" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SettingsSubtitle" Text="决定什么时候回应，以及如何自然地参与聊天。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
        <TextBlock x:Name="SettingsContext" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
        <Border x:Name="SettingsQuotaPanel" Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,16" Visibility="Collapsed"><StackPanel>
         <DockPanel Margin="0,0,0,10"><Button x:Name="SettingsRefresh" Content="刷新额度" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Margin="10,0,0,0"/><TextBlock x:Name="SettingsQuota" Text="今日额度 · 点击刷新查看已用与剩余量" TextWrapping="Wrap" FontSize="11" LineHeight="18" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
         <UniformGrid x:Name="SettingsQuotaCards" Columns="3" Margin="-4,0,-4,0"/>
         <Expander x:Name="SettingsGroupQuotas" Header="各群额度" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock x:Name="SettingsGroupQuotaText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="20" Margin="0,8,0,0"/></Expander>
        </StackPanel></Border>
        <StackPanel x:Name="Fields"/>
        <StackPanel x:Name="SettingsEmpty" Visibility="Collapsed" Margin="25,50"><TextBlock Text="没有找到相关设置" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="试试“主动”“图片”或“额度”。" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel>
       </StackPanel>
      </ScrollViewer>
     <Border Grid.Row="3" BorderBrush="#E3E8F2" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,16,0,0"><DockPanel>
      <Button x:Name="SaveSettings" Content="保存机器人设置" Style="{StaticResource Primary}" DockPanel.Dock="Right" MinWidth="124"/>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SettingsSaveHint" Text="保存此页行为设置" FontSize="12"/><TextBlock Text="媒体服务参数在连接与运行单独保存。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
     </DockPanel></Border>
    </Grid></TabItem>
    <TabItem Tag="Runtime" Header="连接与运行"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,14"><WrapPanel Margin="0,0,0,10"><Button x:Name="OpenQuickSetup" Content="快速配置" Margin="0,0,8,0"/><Button x:Name="OpenAllSettings" Content="全部连接设置" Style="{StaticResource Quiet}"/></WrapPanel><Border x:Name="RuntimeCategoryBar" Background="White" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6"><ListBox x:Name="RuntimeNav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsNavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="连接配置分类"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></Border></StackPanel>
     <ScrollViewer x:Name="RuntimeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
      <TextBlock x:Name="RuntimeTitle" Text="QQ 连接" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="RuntimeSubtitle" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,18"/>
      <Border x:Name="QuickSetupPanel" Style="{StaticResource Surface}" Padding="18" Margin="0,0,0,14" Visibility="Collapsed"><StackPanel>
       <WrapPanel x:Name="QuickSteps" Margin="0,0,0,12"/>
       <TextBlock x:Name="QuickNotice" Text="先完成基础连接，媒体、搜索和高级参数可以稍后配置。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
       <WrapPanel Margin="0,12,0,0"><Button x:Name="PrepareComponents" Content="准备运行组件" Margin="0,0,8,8"/><Button x:Name="DetectEnvironment" Content="自动检测本机环境" Margin="0,0,8,8"/><Button x:Name="ConnectManagedQQ" Content="配置并登录 QQ" Margin="0,0,8,8"/><Button x:Name="CheckSetup" Content="检查当前配置" Margin="0,0,8,8"/><Button x:Name="SetupGuide" Content="查看安装指引" Style="{StaticResource Quiet}" Margin="0,0,0,8"/></WrapPanel>
       <StackPanel x:Name="QuickResults"/>
      </StackPanel></Border>
      <StackPanel x:Name="RuntimeFields"/>
      <Expander x:Name="AdvancedEnv" Header="高级环境文件（自定义参数与排障）" Margin="0,6,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="包含连接凭据，适合自定义参数与排障。常用参数通过表单管理；管理员和回复行为的同名环境项仅提供缺失默认值，当前值请在机器人设置编辑。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBox x:Name="Env" Height="290" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Button x:Name="SaveEnv" Content="保存环境文件" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel></Expander>
     </StackPanel></ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,16,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="QuickBack" Content="上一步" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="QuickNext" Content="下一步" Visibility="Collapsed" Style="{StaticResource Primary}"/><Button x:Name="SaveRuntime" Content="保存连接与媒体" Margin="0,0,10,0"/><Button x:Name="SaveRuntimeRestart" Content="保存并重新启动" Style="{StaticResource Primary}"/></StackPanel><StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="RuntimeSaveScope" Text="保存本页所有分类；机器人设置中的草稿另行保存。" FontSize="10" TextWrapping="Wrap"/><TextBlock x:Name="RuntimeHint" Text="模型参数可热更新；连接地址、密钥和启动文件需重启。" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
    </Grid></TabItem>
    <TabItem Margin="0,14,0,6" Tag="Logs" Header="工作日志"><Border Style="{StaticResource Surface}"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="114"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="LogSearch" Tag="搜索日志内容…" ToolTip="搜索日志" Margin="0,0,10,0"/>
      <ComboBox x:Name="LogFilter" Grid.Column="1" SelectedIndex="0" VerticalContentAlignment="Center"><ComboBoxItem Content="全部日志"/><ComboBoxItem Content="仅错误"/><ComboBoxItem Content="桥接"/><ComboBoxItem Content="NapCat"/></ComboBox>
      <Button x:Name="Pause" Grid.Column="2" Content="暂停滚动" Margin="10,0,8,0"/><Button x:Name="ExportLogs" Grid.Column="3" Content="导出日志"/>
     </Grid>
     <Grid Grid.Row="1"><TextBox x:Name="Logs" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" Background="#F8FAFD" Padding="15" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <StackPanel x:Name="LogEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="还没有工作日志" FontSize="16" Foreground="#8291AC" HorizontalAlignment="Center"/><TextBlock Text="启动机器人后，连接与运行记录会出现在这里。" FontSize="11" Foreground="#94A0B4" Margin="0,9,0,0"/></StackPanel>
     </Grid>
     <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="Clear" Content="清空窗口" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Padding="7,0" FontSize="11"/><TextBlock x:Name="LogCount" Text="保留最近 1500 条日志" Foreground="#8390A6" FontSize="10"/></DockPanel>
    </Grid></Border></TabItem>
    <TabItem Tag="Diagnostics" Header="启动诊断"><Border Style="{StaticResource Surface}"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,18"><Button x:Name="RunDiagnostics" Content="重新检查" Style="{StaticResource Primary}" DockPanel.Dock="Right"/><StackPanel><TextBlock x:Name="DiagnosticSummary" Text="正在检查启动环境…" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="检查依赖、配置路径和访问权限。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></DockPanel>
