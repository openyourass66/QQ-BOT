<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="小鲸工作台" Width="1230" Height="830" MinWidth="1000" MinHeight="710"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#F5F7FB" Foreground="#25324B" FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Text" Color="#25324B"/>
  <SolidColorBrush x:Key="Muted" Color="#66748C"/>
  <SolidColorBrush x:Key="Accent" Color="#4B68E8"/>
  <SolidColorBrush x:Key="Line" Color="#E8EDF5"/>
  <Style x:Key="Surface" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#405170"/>
   <Setter Property="BorderBrush" Value="#DEE5F1"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"
            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.76"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.58"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#3354DA"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#4B68E8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4B68E8"/>
  </Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#5B6D94"/><Setter Property="Padding" Value="10,7"/>
  </Style>
  <Style x:Key="CaptionFocus" TargetType="Control">
   <Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="6" Stroke="#4B68E8" StrokeThickness="1" StrokeDashArray="2,2" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Caption" TargetType="Button">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#60708C"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource CaptionFocus}"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E9EEF7"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCE5F3"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D94555"/><Setter Property="Foreground" Value="White"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#BA3444"/><Setter Property="Foreground" Value="White"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="#FAFBFD"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="#DEE5F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Input" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
     <Grid><ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
      <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#77849B" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#5275EF"/><Setter TargetName="Input" Property="Background" Value="White"/></Trigger>
     <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="#FAFBFD"/><Setter Property="BorderBrush" Value="#DEE5F0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border x:Name="Input" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#5275EF"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="36" Height="21" CornerRadius="11" Background="#C5CEDF">
     <Ellipse x:Name="Thumb" Fill="White" Width="15" Height="15" HorizontalAlignment="Left" Margin="3"/>
    </Border><TextBlock x:Name="SwitchText" Text="关闭" Foreground="#66748C" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12"/></StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#4B68E8"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchText" Property="Text" Value="开启"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderThickness" Value="2"/><Setter TargetName="Track" Property="BorderBrush" Value="#24365A"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Padding" Value="13,9"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Foreground" Value="#60708D"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Chip" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="Background" Value="#EDF1FF"/><Setter Property="Foreground" Value="#3A58CF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#5275EF"/><Setter TargetName="Chip" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#25324B"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,6"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Nav" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#EDF1FF"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="#DFE7FC"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="#4B68E8"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Background="#F5F7FB" BorderBrush="#DAE2F0" BorderThickness="1" CornerRadius="10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.ColumnSpan="2" Background="#FCFDFF" BorderBrush="#E8EDF5" BorderThickness="0,0,0,1">
    <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="Minimize" Style="{StaticResource Caption}" ToolTip="最小化" AutomationProperties.Name="最小化"><Grid Width="12" Height="12"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M1,6.5 H11"/></Grid></Button>
     <Button x:Name="Maximize" Style="{StaticResource Caption}" ToolTip="最大化" AutomationProperties.Name="最大化或还原"><Grid Width="12" Height="12"><Path x:Name="MaximizeGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M1.5,1.5 H10.5 V10.5 H1.5 Z"/></Grid></Button>
     <Button x:Name="CloseWindow" Style="{StaticResource CaptionClose}" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口"><Grid Width="12" Height="12"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M1.5,1.5 L10.5,10.5 M1.5,10.5 L10.5,1.5"/></Grid></Button>
    </StackPanel><TextBlock Text="小鲸工作台" Foreground="#7A879D" FontSize="11" Margin="19,0,0,0" VerticalAlignment="Center"/></DockPanel>
   </Border>
   <Border Grid.Row="1" Background="White" BorderBrush="#E8EDF5" BorderThickness="0,0,1,0">
    <Grid Margin="20,28,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><DockPanel><Image x:Name="BrandIcon" Width="36" Height="36" DockPanel.Dock="Left" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="小鲸" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="WHALE DESK" Foreground="#8491A7" FontSize="9" Margin="0,2,0,0"/></StackPanel></DockPanel><TextBlock Text="工作空间" FontSize="10" Foreground="#98A3B6" Margin="12,35,0,0"/></StackPanel>
     <TextBlock Grid.Row="2" Text="QQ BOT  /  轻量桌面端" Foreground="#96A2B6" FontSize="10" Margin="12,0,0,0"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Grid.Column="1" Margin="28,24,28,0" VerticalAlignment="Top">
    <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="Uptime" Text="尚未启动" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/><Border x:Name="ConnectionPill" Background="#EDF1F7" CornerRadius="13" Padding="11,6"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Fill="#98A5BC" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionBadge" Text="未启动" Foreground="#66748C" FontSize="11"/></StackPanel></Border></StackPanel>
     <StackPanel><TextBlock x:Name="PageTitle" Text="工作总览" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="连接、消息与运行状态，一目了然。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    </DockPanel>
   </Grid>
   <TabControl x:Name="Tabs" Grid.Row="1" Grid.ColumnSpan="2" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel IsItemsHost="True" VerticalAlignment="Top" Margin="12,126,12,0"/>
     <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" TextElement.Foreground="#25324B" Margin="28,104,28,42"/>
    </Grid></ControlTemplate></TabControl.Template>
    <TabItem Header="工作总览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border CornerRadius="18" Padding="24,22" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#E9EFFF"/><GradientStop Color="#F0F5FF" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
       <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#DDE6FF" CornerRadius="5" Padding="7,3"><TextBlock Text="HELLO, WHALE" FontSize="9" Foreground="#536FC0" FontWeight="SemiBold"/></Border><TextBlock Text="今天也请多多关照" Foreground="#7384A9" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel>
        <TextBlock x:Name="State" Text="小鲸准备好了，随时出发" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,7" TextWrapping="Wrap"/>
        <TextBlock x:Name="Stats" Text="启动机器人，开始今天的陪伴。" Foreground="#60759F" FontSize="12" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="Start" Style="{StaticResource Primary}" Content="启动机器人" MinWidth="122" Margin="0,0,10,0"/><Button x:Name="Stop" Content="停止运行" Background="#F8FAFF"/></StackPanel>
       </StackPanel>
       <Image x:Name="HeroIcon" Grid.Column="1" Width="216" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Border Style="{StaticResource Surface}" Margin="0,0,0,18" Padding="8,19"><UniformGrid Columns="4">
      <StackPanel Margin="18,0"><TextBlock Text="收到消息" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MessagesIn" Text="0" FontSize="26" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="本次运行" FontSize="10" Foreground="#94A0B4"/></StackPanel>
      <StackPanel Margin="18,0"><TextBlock Text="已发送回复" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MessagesOut" Text="0" FontSize="26" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="成功送达 QQ" FontSize="10" Foreground="#94A0B4"/></StackPanel>
      <StackPanel Margin="18,0"><TextBlock Text="活跃会话" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Sessions" Text="0" FontSize="26" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="按需恢复上下文" FontSize="10" Foreground="#94A0B4"/></StackPanel>
      <StackPanel Margin="18,0"><TextBlock Text="待处理消息" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Pending" Text="0" FontSize="26" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock x:Name="QueueState" Text="队列空闲" FontSize="10" Foreground="#94A0B4"/></StackPanel>
     </UniformGrid></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Surface}" Margin="0,0,16,0"><StackPanel>
       <DockPanel Margin="0,0,0,18"><TextBlock Text="服务连接" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="QQ → 模型" Foreground="#94A0B4" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
       <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#ECF6F2" CornerRadius="10" Width="31" Height="31" VerticalAlignment="Top"><Path Stroke="#53A38A" StrokeThickness="1.5" Data="M2,2 H14 V11 H9 L5,15 V11 H2 Z" Stretch="Uniform" Margin="8"/></Border><StackPanel Grid.Column="1"><TextBlock Text="QQ · NapCat" FontWeight="Medium"/><TextBlock x:Name="NapcatState" Text="等待启动" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="QqState" Grid.Column="2" Text="未连接" Foreground="#7F8BA2" FontSize="11" VerticalAlignment="Center"/></Grid>
       <Border Background="#EEF1F7" Height="1" Margin="0,0,0,17"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#EDF0FF" CornerRadius="10" Width="31" Height="31" VerticalAlignment="Top"><Path Stroke="#647DEA" StrokeThickness="1.5" Data="M7,1 L8,5 L12,6 L8,7 L7,11 L6,7 L2,6 L6,5 Z" Stretch="Uniform" Margin="8"/></Border><StackPanel Grid.Column="1"><TextBlock Text="DeepSeek · DSH" FontWeight="Medium"/><TextBlock x:Name="ModelState" Text="等待连接" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button x:Name="Restart" Grid.Column="2" Content="重连" Style="{StaticResource Quiet}" ToolTip="重新连接模型，保留 QQ 登录"/></Grid>
       <Border Background="#F7F9FD" CornerRadius="9" Padding="11" Margin="0,18,0,0"><TextBlock Text="模型重连会保留 QQ 登录状态" Foreground="#71809A" FontSize="10" TextWrapping="Wrap"/></Border>
      </StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Surface}"><StackPanel><DockPanel Margin="0,0,0,18"><TextBlock Text="环境检查" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="启动诊断" Foreground="#94A0B4" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><TextBlock Text="运行依赖、连接配置与文件权限" Foreground="#71809A" FontSize="11" Margin="0,0,0,12"/><TextBlock x:Name="HealthSummary" Text="检查环境，确认小鲸已经准备好。" Foreground="#526787" TextWrapping="Wrap" FontSize="12"/><Button x:Name="Diagnose" Content="查看启动诊断 →" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="-10,16,0,0"/></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="运行日志"><Border Style="{StaticResource Surface}"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="114"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="LogSearch" Tag="搜索日志内容…" ToolTip="搜索日志" Margin="0,0,10,0"/>
      <ComboBox x:Name="LogFilter" Grid.Column="1" SelectedIndex="0" VerticalContentAlignment="Center"><ComboBoxItem Content="全部日志"/><ComboBoxItem Content="仅错误"/><ComboBoxItem Content="桥接"/><ComboBoxItem Content="NapCat"/></ComboBox>
      <Button x:Name="Pause" Grid.Column="2" Content="暂停滚动" Margin="10,0,8,0"/><Button x:Name="ExportLogs" Grid.Column="3" Content="导出日志"/>
     </Grid>
     <Grid Grid.Row="1"><TextBox x:Name="Logs" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" Background="#F8FAFD" Padding="15" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <StackPanel x:Name="LogEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="还没有工作日志" FontSize="16" Foreground="#8291AC" HorizontalAlignment="Center"/><TextBlock Text="启动机器人后，连接与运行记录会出现在这里。" FontSize="11" Foreground="#94A0B4" Margin="0,9,0,0"/></StackPanel>
     </Grid>
     <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="Clear" Content="清空窗口" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Padding="7,0" FontSize="11"/><TextBlock x:Name="LogCount" Text="保留最近 1500 条日志" Foreground="#8390A6" FontSize="10"/></DockPanel>
    </Grid></Border></TabItem>
    <TabItem Header="机器人设置"><Border Style="{StaticResource Surface}"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="Fields"/></StackPanel></ScrollViewer>
     <DockPanel Grid.Row="1" Margin="0,17,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SaveSettings" Content="保存设置" Style="{StaticResource Primary}"/></StackPanel><TextBlock Text="保存后即时生效" FontSize="10" Foreground="#8390A6" VerticalAlignment="Center"/></DockPanel>
    </Grid></Border></TabItem>
    <TabItem Header="连接配置"><Border Style="{StaticResource Surface}"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel>
      <StackPanel x:Name="RuntimeFields"/>
      <Expander Header="高级：完整 .env" Margin="0,18,0,0"><StackPanel><TextBlock Text="可编辑自定义参数，包含连接凭据。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/><TextBox x:Name="Env" Height="290" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Button x:Name="SaveEnv" Content="保存高级文本" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel></Expander>
     </StackPanel></ScrollViewer>
     <DockPanel Grid.Row="1" Margin="0,17,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SaveRuntime" Content="保存连接配置" Style="{StaticResource Primary}"/></StackPanel><TextBlock x:Name="RuntimeHint" Text="连接配置需重启生效" Foreground="#8390A6" FontSize="10" VerticalAlignment="Center"/></DockPanel>
    </Grid></Border></TabItem>
    <TabItem Header="人设与记忆"><Border Style="{StaticResource Surface}"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,16"><Button x:Name="Memory" Content="打开记忆目录" DockPanel.Dock="Right" Padding="12,8"/><StackPanel Margin="0,0,16,0"><TextBlock Text="人设文档" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="PersonaHint" Text="新会话将读取保存后的人设。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="420"/></StackPanel></DockPanel>
     <TextBox x:Name="Persona" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" FontSize="13" VerticalScrollBarVisibility="Auto" Padding="18"/>
     <DockPanel Grid.Row="2" Margin="0,17,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SavePersona" Content="保存人设" Style="{StaticResource Primary}"/></StackPanel><TextBlock Text="已有会话不会自动重置" Foreground="#8390A6" FontSize="10" VerticalAlignment="Center"/></DockPanel>
    </Grid></Border></TabItem>
    <TabItem Header="启动诊断"><Border Style="{StaticResource Surface}"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
