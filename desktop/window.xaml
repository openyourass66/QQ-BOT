<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鲸鱼 · QQ BOT 桌面控制台" Width="1100" Height="780" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F8FF" Foreground="#233958"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="MutedBrush" Color="#536B89"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DBE8F7"/>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CCDDF2"/><Setter Property="Foreground" Value="#29486D"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#3B62D9"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3E63DC"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3E63DC"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,9"/>
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#233958"/>
      <Setter Property="BorderBrush" Value="#B7CCE7"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#D9E6FF"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputBorder" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#3B62D9"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="MinHeight" Value="38"/><Setter Property="MinWidth" Value="48"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent" Width="48" Height="38">
          <Border x:Name="Track" Height="24" CornerRadius="12" Background="#C6D4E8"/>
          <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#3E63DC"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#233958"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#DDE9FF"/><Setter Property="Foreground" Value="#244DB0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#3E63DC"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#EAF2FF"><DockPanel Margin="18,30,18,20">
      <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30"><TextBlock Text="小鲸鱼 · BOT" FontSize="23" FontWeight="Bold" Foreground="#3157B8"/><TextBlock Text="让每次对话，泛起小浪花" Foreground="#566F94" FontSize="12" Margin="0,8,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,0"><TextBlock Text="YOUR LITTLE COMPANION" Foreground="#3157B8" FontSize="10"/><TextBlock Text="关掉窗口，小鲸鱼仍在托盘等你" Foreground="#566F94" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
      <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="#425F86" SelectedIndex="0" AutomationProperties.Name="功能导航">
        <ListBoxItem Content="运行概览"/><ListBoxItem Content="机器人配置"/><ListBoxItem Content="角色与人设"/><ListBoxItem Content="会话管理"/><ListBoxItem Content="运行日志"/>
      </ListBox>
    </DockPanel></Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,0"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="ConnectionLabel" Text="正在启动本地控制服务…" Foreground="{StaticResource MutedBrush}" FontSize="12" DockPanel.Dock="Right"/><TextBlock Text="小鲸鱼的工作舱  /  QQ BOT" FontSize="12"/></DockPanel></Border>
      <Grid Grid.Row="1" Margin="30,26,30,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24"><TextBlock x:Name="PageTitle" Text="运行概览" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="今天也一起，把每一句话好好接住。" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel>
        <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel>
          <Border Style="{StaticResource Card}" Background="#E7F0FF" BorderBrush="#CDDEFF"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel>
            <TextBlock Text="READY TO MAKE A LITTLE SPLASH" FontSize="10" Foreground="#456A9D"/>
            <DockPanel Margin="0,12,0,8"><Border DockPanel.Dock="Right" Background="#D7E7FF" Padding="12,4" CornerRadius="5"><TextBlock x:Name="PhaseLabel" Text="已停止" Foreground="#2E54A1" FontSize="12"/></Border><TextBlock x:Name="BotName" Text="QQ 机器人" FontSize="24" FontWeight="SemiBold"/></DockPanel>
            <TextBlock x:Name="RuntimeDetail" Text="控制台保持在线，随时可以启动机器人。" Style="{StaticResource Hint}" Margin="0,0,0,22"/>
            <StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="启动机器人" Style="{StaticResource PrimaryButton}" IsEnabled="False"/><Button x:Name="StopButton" Content="停止" Foreground="#A73232" IsEnabled="False"/><Button x:Name="RestartButton" Content="重新启动" IsEnabled="False"/></StackPanel>
          </StackPanel><Viewbox Grid.Column="1" Width="160" Height="144" Margin="12,0,0,0" IsHitTestVisible="False"><Canvas Width="200" Height="180">
<Ellipse Width="170" Height="18" Canvas.Left="10" Canvas.Top="153" Fill="#D3E2FF"/>
<Ellipse Width="14" Height="14" Canvas.Left="20" Canvas.Top="22" Stroke="#A8C8FF" StrokeThickness="3"/>
<Ellipse Width="8" Height="8" Canvas.Left="48" Canvas.Top="7" Fill="#B9D5FF"/>
<Path Data="M 143,89 C 170,85 166,51 191,48 C 188,67 201,75 190,94 C 182,109 163,116 149,112 Z" Fill="#416CE1"/>
<Path Data="M 19,100 C 12,59 45,39 90,43 C 134,45 162,69 160,105 C 158,141 111,156 69,144 C 39,137 22,122 19,100 Z" Fill="#4D79EF"/>
<Path Data="M 26,109 C 58,128 110,133 153,110 C 137,144 96,154 61,141 C 43,135 32,123 26,109 Z" Fill="#BFD9FF"/>
<Path Data="M 91,112 C 93,133 111,142 124,132 C 113,128 115,114 111,107 Z" Fill="#365ECC"/>
<Ellipse Width="9" Height="12" Canvas.Left="43" Canvas.Top="82" Fill="#203C79"/>
<Ellipse Width="3" Height="4" Canvas.Left="45" Canvas.Top="83" Fill="White"/>
<Ellipse Width="18" Height="8" Canvas.Left="30" Canvas.Top="102" Fill="#F4BACC"/>
<Path Data="M 48,106 Q 57,114 66,105" Stroke="#234988" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
<Path Data="M 80,38 Q 66,17 77,17 Q 86,19 86,33 Q 91,12 101,19 Q 106,26 89,39" Fill="#80B6FF"/>
</Canvas></Viewbox></Grid></Border>
          <UniformGrid Columns="4" Margin="0,0,-12,0">
            <Border Style="{StaticResource Card}" Background="#F0F6FF" Padding="18" Margin="0,0,12,18"><StackPanel><TextBlock Text="收到的问候" Style="{StaticResource Hint}"/><TextBlock x:Name="MessagesIn" Text="—" FontSize="28" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,18"><StackPanel><TextBlock Text="送出的回应" Style="{StaticResource Hint}"/><TextBlock x:Name="MessagesOut" Text="—" FontSize="28" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,18"><StackPanel><TextBlock Text="对话小伙伴" Style="{StaticResource Hint}"/><TextBlock x:Name="SessionCount" Text="—" FontSize="28" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,18"><StackPanel><TextBlock Text="排队中的消息" Style="{StaticResource Hint}"/><TextBlock x:Name="PendingCount" Text="—" FontSize="28" Margin="0,7,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="连接补给站" Style="{StaticResource Heading}"/><TextBlock x:Name="Connections" Text="OneBot  未连接     ·     DSH / ACP  未连接     ·     QQ  离线" TextWrapping="Wrap"/><TextBlock x:Name="AccountInfo" Text="等待获取 QQ 登录信息" Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="打个招呼，试试连接" Style="{StaticResource Heading}"/><Label Target="{Binding ElementName=TestMessage}" Content="向管理员 QQ 发送私聊消息" Foreground="{StaticResource MutedBrush}" FontSize="12"/><DockPanel><Button x:Name="TestButton" DockPanel.Dock="Right" Content="发送测试" Margin="12,0,0,0"/><TextBox x:Name="TestMessage" Text="你好，机器人已准备就绪。" MaxLength="2000"/></DockPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="EnvButton" Content="连接配置 (.env)"/><Button x:Name="SaveSettingsButton" Content="保存配置" Style="{StaticResource PrimaryButton}" IsEnabled="False"/></StackPanel><TextBlock Text="保存后自动热更新" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel x:Name="SettingsFields"/></ScrollViewer></Grid>
        <Grid x:Name="PersonaPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="定义机器人的身份、语气与规则。保存后可重置相关会话，让新设定进入新的上下文。" Style="{StaticResource Hint}" Margin="0,0,0,16"/><TextBox x:Name="PersonaText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Top" AutomationProperties.Name="角色设定与工作区说明"/><Button x:Name="SavePersonaButton" Grid.Row="2" Content="保存人设" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="False"/></Grid>
        <Grid x:Name="SessionsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button x:Name="RefreshSessionsButton" Content="刷新会话" DockPanel.Dock="Right"/><TextBlock Text="重置后，下次消息会创建新的上下文。" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SessionList"/></ScrollViewer></Grid>
        <Grid x:Name="LogsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button x:Name="PauseLogsButton" Content="暂停刷新" DockPanel.Dock="Right"/><TextBox x:Name="LogSearch" AutomationProperties.Name="筛选日志关键词" ToolTip="筛选日志关键词" MinWidth="180"/><TextBlock Text="关键词" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource MutedBrush}"/></DockPanel><TextBox x:Name="LogText" Grid.Row="1" Background="#F8FBFF" Foreground="#29486D" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.Name="运行日志"/></Grid>
      </Grid>
      <Border Grid.Row="2" Background="#E5EFFF" Padding="30,0"><TextBlock x:Name="Feedback" Text="小鲸鱼已就位 · 点击启动，开启今天的对话" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></Border>
    </Grid>
  </Grid>
</Window>
