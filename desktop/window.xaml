<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小鲸 · QQ 机器人控制台" Width="1120" Height="800" MinWidth="860" MinHeight="640" Background="#F2F6FF" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#24365A" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#E8EEFF"/><Setter Property="Foreground" Value="#254780"/><Setter Property="Padding" Value="20,12"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#24365A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#C1CDE4"/><Setter Property="Background" Value="#FBFCFF"/><Setter Property="Foreground" Value="#24365A"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" CornerRadius="13,13,0,0" Background="#E5ECFC" Margin="0,0,5,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="White"/><Setter Property="Foreground" Value="#354EC8"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#24365A"/><Setter TargetName="Tab" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8"/></Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="140"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="小鲸的工作台" FontSize="29" FontWeight="Bold"/><TextBlock Text="把忙碌交给小鲸，把陪伴留给朋友。" Foreground="#526587" Margin="0,8,0,0"/></StackPanel>
      <Viewbox Grid.Column="1" Width="160" HorizontalAlignment="Right"><Canvas Width="220" Height="110">
        <Ellipse Fill="#DCE7FF" Width="150" Height="95" Canvas.Left="20" Canvas.Top="7"/>
        <Path Fill="#4D6BFE" Data="M 26,54 C 24,12 102,8 133,40 C 150,54 162,62 181,36 L 181,64 L 203,51 C 197,94 153,95 135,76 C 105,114 33,103 26,54 Z"/>
        <Path Fill="#FAFCFF" Data="M 33,65 Q 76,106 129,73 Q 101,111 54,92 Z"/>
        <Ellipse Fill="#24365A" Width="9" Height="10" Canvas.Left="52" Canvas.Top="47"/><Ellipse Fill="White" Width="3" Height="3" Canvas.Left="54" Canvas.Top="48"/>
        <Ellipse Fill="#FFBBD5" Width="16" Height="7" Canvas.Left="41" Canvas.Top="63"/>
        <Path Stroke="#4D6BFE" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 78,14 Q 64,-1 57,10 M 80,15 Q 88,-1 98,7"/>
      </Canvas></Viewbox>
    </Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="22" Padding="24" Margin="0,0,0,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="State" Text="小鲸正在准备中…" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="Stats" Text="启动后显示 QQ、模型连接与消息状态" Foreground="#526587" Margin="0,10,12,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Start" Content="开始工作" Background="#4D6BFE" Foreground="White"/><Button x:Name="Stop" Content="休息一下"/><Button x:Name="Restart" Content="重新启动" Margin="0"/></StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="2" x:Name="Tabs" BorderThickness="0" Background="White">
      <TabItem Header="运行日志"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="Pause" Content="暂停滚动" Padding="14,7"/><Button x:Name="Clear" Content="清空日志" Padding="14,7" Margin="0"/></StackPanel><TextBlock Text="小鲸的工作日记 · 最多保留 1500 行" VerticalAlignment="Center" Foreground="#526587"/></DockPanel><TextBox x:Name="Logs" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#F7F9FF" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
      <TabItem Header="机器人设置"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="保存后热更新 · 浏览器开关与额度目前尚未接入执行逻辑" Foreground="#526587" Margin="0,0,0,14"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Fields"/></ScrollViewer><Button x:Name="SaveSettings" Grid.Row="2" Content="保存机器人设置" Background="#4D6BFE" Foreground="White" HorizontalAlignment="Right" Margin="0,14,0,0"/></Grid></TabItem>
      <TabItem Header="连接与运行"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="全部 .env 参数 · 保存后重新启动生效 · 含凭据，请勿分享截图" Foreground="#526587" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBox x:Name="Env" Grid.Row="1" FontFamily="Consolas, Microsoft YaHei UI" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Button x:Name="SaveEnv" Grid.Row="2" Content="保存连接与运行配置" Background="#4D6BFE" Foreground="White" HorizontalAlignment="Right" Margin="0,14,0,0"/></Grid></TabItem>
      <TabItem Header="人设与记忆"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="PersonaHint" Text="人设保存在工作区 AGENTS.md，新建会话时生效。" Foreground="#526587" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBox x:Name="Persona" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button x:Name="Memory" Content="打开记忆目录"/><Button x:Name="SavePersona" Content="保存人设" Background="#4D6BFE" Foreground="White" Margin="0"/></StackPanel></Grid></TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="4,14,4,0"><TextBlock DockPanel.Dock="Right" Text="关闭窗口收进托盘 · 右键托盘可退出" Foreground="#526587" FontSize="12"/><TextBlock x:Name="Feedback" Text="你好，今天也一起好好工作吧。" Foreground="#526587" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel>
  </Grid>
</Window>
