<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小鲸工作台" Width="1240" Height="860" MinWidth="1000" MinHeight="720" Background="#F5F7FC" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#253454" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#687793"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#E6EBF5"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#EDF1FD"/><Setter Property="Foreground" Value="#41547A"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.80"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#263FAD"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="Foreground" Value="#253454"/><Setter Property="Background" Value="#FAFBFE"/><Setter Property="BorderBrush" Value="#CBD5E8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#CBD5E8"/><Setter Property="Background" Value="#FAFBFE"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#C1CCDF"><Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#4D6BFE"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderThickness" Value="2"/><Setter TargetName="Track" Property="BorderBrush" Value="#24365A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#253454"/><Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="0,0,10,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="12"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#E8EEFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#3855D8"/><Setter TargetName="Tab" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F5F7FC">
  <Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#E6EBF5" BorderThickness="0,0,1,0">
   <Grid Margin="20,30,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Image x:Name="BrandIcon" Width="52" Height="52" HorizontalAlignment="Left"/><TextBlock Text="小鲸工作台" FontSize="21" FontWeight="Bold" Margin="0,14,0,5"/><TextBlock Text="你的 QQ 陪伴小助手" FontSize="11" Foreground="{StaticResource Muted}"/><Border Height="1" Background="#EBEFF7" Margin="0,25,0,0"/></StackPanel>
    <Border Grid.Row="2" Background="#F2F5FF" Padding="14" CornerRadius="15"><StackPanel><TextBlock Text="小鲸一直在这里" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="TrayHint" Text="关窗后在托盘继续陪伴你" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/><Button x:Name="ExitApp" Content="退出工作台" Background="White" Padding="10,8"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="26,24,26,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="2,0,0,18"><Border DockPanel.Dock="Right" Background="#E8F6F0" CornerRadius="10" Padding="12,7"><TextBlock x:Name="ConnectionBadge" Text="本地控制 · 轻量运行" Foreground="#28745B" FontSize="11"/></Border><StackPanel><TextBlock Text="今天，也一起好好工作吧" FontSize="24" FontWeight="Bold"/><TextBlock Text="让连接更简单，让陪伴更有温度。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
   <TabControl x:Name="Tabs" Grid.Row="1" TabStripPlacement="Left" BorderThickness="0" Background="Transparent" Margin="-206,0,0,0">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel IsItemsHost="True" Margin="0,100,0,0" VerticalAlignment="Top"/><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" TextElement.Foreground="#253454" TextElement.FontWeight="Normal" Margin="26,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid></ControlTemplate></TabControl.Template>
    <TabItem Header="◉   工作总览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border CornerRadius="24" Padding="26" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E4EBFF"/><GradientStop Color="#F0EBFF" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WHALE  /  CONTROL CENTER" Foreground="#586ED0" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="State" Text="小鲸休息中，随时可以出发" FontSize="25" FontWeight="Bold" Margin="0,13,0,9" TextWrapping="Wrap"/><TextBlock x:Name="Stats" Text="连接 QQ 与模型后，就能开始今天的陪伴。" Foreground="#5B6D94" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,21,0,0"><Button x:Name="Start" Content="▶  启动机器人" Background="#4D6BFE" Foreground="White" Margin="0,0,10,0"/><Button x:Name="Stop" Content="停止" Background="White" Margin="0,0,10,0"/><Button x:Name="Restart" Content="重连模型" Background="#D8E1FF"/></StackPanel></StackPanel><Image x:Name="HeroIcon" Grid.Column="1" Width="142" Height="142" HorizontalAlignment="Right"/></Grid>
     </Border>
     <UniformGrid Columns="3" Margin="0,0,0,18">
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="QQ 连接" Foreground="{StaticResource Muted}"/><TextBlock x:Name="QqState" Text="未连接" FontSize="22" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="NapcatState" Text="NapCat 等待启动" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="DeepSeek 模型" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ModelState" Text="等待唤醒" FontSize="22" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="Uptime" Text="独立重连，不打断 QQ 登录" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="今日工作 · 本次运行" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MessageCount" Text="0 / 0" FontSize="22" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="QueueState" Text="收到 / 回复 · 排队 0" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button x:Name="Diagnose" Content="检查启动环境 →" DockPanel.Dock="Right" Padding="14,8"/><TextBlock Text="小鲸的启动检查单" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="找出路径、运行库、Profile 权限与连接配置问题。" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><TextBlock x:Name="HealthSummary" Text="点击检查，确认小鲸已经准备好。" TextWrapping="Wrap" Foreground="#526587"/><Border x:Name="ErrorBanner" Background="#FFF0F1" CornerRadius="12" Padding="14" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock x:Name="LastError" Foreground="#A02F44" TextWrapping="Wrap"/></Border></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="≡   工作日志"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button x:Name="ExportLogs" Content="导出日志" DockPanel.Dock="Right" Padding="12,7"/><TextBlock Text="每一次连接，都有迹可循" FontSize="20" FontWeight="Bold"/></DockPanel><DockPanel Grid.Row="1" Margin="0,18,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Pause" Content="暂停滚动" Padding="12,8" Margin="8,0,8,0"/><Button x:Name="Clear" Content="清空" Padding="12,8"/></StackPanel><TextBox x:Name="LogSearch" ToolTip="搜索日志" Width="200" HorizontalAlignment="Left" Padding="10,8"/><ComboBox x:Name="LogFilter" SelectedIndex="0" Margin="10,0,0,0" Width="100"><ComboBoxItem Content="全部日志"/><ComboBoxItem Content="只看错误"/><ComboBoxItem Content="桥接"/><ComboBoxItem Content="NapCat"/></ComboBox></DockPanel><TextBox x:Name="Logs" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#F7F9FD" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border></TabItem>
    <TabItem Header="⚙   机器人设置"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,15"><TextBlock Text="调成你喜欢的小鲸" FontSize="22" FontWeight="Bold"/><TextBlock Text="对话、回复节奏、审批与每日额度 · 保存后热更新" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Fields"/></ScrollViewer><DockPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="SaveSettings" Content="保存机器人设置" DockPanel.Dock="Right" Background="#4D6BFE" Foreground="White"/><TextBlock Text="浏览器设置尚未接入执行逻辑" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel></Grid></Border></TabItem>
    <TabItem Header="⌁   连接与运行"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,15"><TextBlock Text="让 QQ 和小鲸连起来" FontSize="22" FontWeight="Bold"/><TextBlock Text="可视化连接配置 · 令牌默认隐藏 · 保存后重启生效" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="RuntimeFields"/><Expander Header="高级：完整 .env 文件（含自定义参数）" Margin="0,18,0,0"><StackPanel><TextBox x:Name="Env" Height="220" Margin="0,12,0,10" FontFamily="Consolas, Microsoft YaHei UI" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Button x:Name="SaveEnv" Content="保存高级文本" HorizontalAlignment="Right"/></StackPanel></Expander></StackPanel></ScrollViewer><Button x:Name="SaveRuntime" Grid.Row="2" Content="保存连接配置" Background="#4D6BFE" Foreground="White" HorizontalAlignment="Right" Margin="0,16,0,0"/></Grid></Border></TabItem>
    <TabItem Header="♡   人设与记忆"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,15"><TextBlock Text="给小鲸一点独特的灵魂" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="PersonaHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/></StackPanel><TextBox x:Name="Persona" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="Memory" Content="打开记忆目录" Margin="0,0,10,0"/><Button x:Name="SavePersona" Content="保存人设" Background="#4D6BFE" Foreground="White"/></StackPanel></Grid></Border></TabItem>
    <TabItem Header="⊙   启动诊断"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="小鲸的健康检查" FontSize="22" FontWeight="Bold"/><TextBlock Text="逐项排查启动依赖，定位失败原因。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Diagnostics"/></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="OpenLogs" Content="打开日志目录" Margin="0,0,10,0"/><Button x:Name="RunDiagnostics" Content="重新检查" Background="#4D6BFE" Foreground="White"/></StackPanel></Grid></Border></TabItem>
   </TabControl>
   <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="SaveState" DockPanel.Dock="Right" Text="所有修改已保存" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Feedback" Text="你好，小鲸正在准备今天的工作台。" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel>
  </Grid>
 </Grid>
</Window>
