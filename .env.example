# ===== OneBot（NapCat）=====
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_TOKEN=

# ===== 机器人 =====
BOT_SELF_ID=0
ADMIN_QQ=0
GROUP_PREFIX=
GROUP_COOLDOWN_MS=3000
REPLY_CHUNK_SIZE=600
MIN_DELAY_MS=700
MAX_DELAY_MS=2400
TURN_TIMEOUT_MS=180000
GROUP_CONTEXT_LINES=6

# ===== DSH =====
BOT_DSH_BIN=D:\DeepSeek Harness\resources\runtime\cli\bin\dsh.cmd
BOT_DSH_PROFILE=acp
BOT_WORKSPACE=D:\Project\software\QQ-BOT\bot-workspace

# ===== 其它 =====
SESSION_STORE=D:\Project\software\QQ-BOT\data\sessions.json
# 默认与 SESSION_STORE 同目录；由单个桥接进程管理每日额度
BOT_USAGE_STORE=D:\Project\software\QQ-BOT\data\daily-usage.json
ALLOW_EXEC=0

# 动态配置：文件显式值优先，缺失字段使用以上环境变量
BOT_SETTINGS_FILE=bot.config.json
# 管理 API 仅监听本机；静态界面需自行提供 public 目录
ADMIN_UI_PORT=6080
ADMIN_UI_TOKEN=
