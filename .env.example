# ===== OneBot（NapCat）=====
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_TOKEN=

# ===== 机器人 =====
BOT_SELF_ID=0
ADMIN_QQ=0
GROUP_PREFIX=
GROUP_COOLDOWN_MS=3000
REPLY_CHUNK_SIZE=600
MIN_DELAY_MS=700
MAX_DELAY_MS=2400
TURN_TIMEOUT_MS=180000
GROUP_CONTEXT_LINES=6
# 包含正在处理的消息；超过容量的消息不进入模型队列
QUEUE_PER_CONVERSATION=5
QUEUE_TOTAL=50
MAX_CONCURRENT_TURNS=4

# ===== DSH =====
BOT_DSH_BIN=dsh.cmd
BOT_DSH_PROFILE=acp
BOT_WORKSPACE=bot-workspace

# 对话模型：profile 沿用 DSH；project 使用本项目 Key；account 复用 DSH 登录态
BOT_CHAT_MODE=profile
BOT_CHAT_MODEL=deepseek-flash
# 自定义服务需兼容 DeepSeek Messages 协议
BOT_CHAT_BASE_URL=https://api.deepseek.com/anthropic
QQ_BOT_DEEPSEEK_API_KEY=

# ===== 其它 =====
SESSION_STORE=data/sessions.json
# 默认与 SESSION_STORE 同目录；由单个桥接进程管理每日额度
BOT_USAGE_STORE=data/daily-usage.json
ALLOW_EXEC=0

# 动态配置：文件显式值优先，缺失字段使用以上环境变量
BOT_SETTINGS_FILE=bot.config.json
# 群上下文默认保存到 SESSION_STORE 同目录的 group-context.json
# BOT_GROUP_CONTEXT_STORE=data/group-context.json
# 可选：独立启动 NapCat Node 环境（npm run napcat，需先部署官方适配库）
# BOT_QQ_DIR=D:\app\qq
# BOT_NAPCAT_DIR=napcat/shell

# 可选媒体与适配服务：未配置时明确不可用，详见 docs/usage.md
BOT_MEDIA_BASE_URL=
BOT_MEDIA_API_KEY=
BOT_FFMPEG_BIN=
BOT_SEARCH_URL=
BOT_SEARCH_API_KEY=
BOT_TAVILY_API_KEY=
BOT_QZONE_ADAPTER_URL=
BOT_QZONE_ADAPTER_TOKEN=
BOT_MEDIA_IMPORT_DIRS=
# BOT_SOCIAL_STORE=data/social.json
# BOT_MEDIA_DIR=data/media
# BOT_MEDIA_MAX_BYTES=536870912

# 后台记忆整理：留空时仅复用本项目 API Key 模式，不读取 DSH 登录凭据
BOT_LEARNING_BASE_URL=
BOT_LEARNING_API_KEY=
BOT_LEARNING_MODEL=
